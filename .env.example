# Copy to .env.local for local dev, or set these in Vercel → Settings →
# Environment Variables for the deployed site.
#
# Everything in the app works WITHOUT these. They enable one optional feature:
# the "Live coach" tab in Speak, which holds a real conversation with the
# learner. With no key set, /api/coach returns 501, the tab doesn't appear, and
# the scripted partner is used instead.

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# NEVER prefix this with VITE_ — anything VITE_-prefixed is compiled into the
# browser bundle, which would publish your key to every visitor.
ANTHROPIC_API_KEY=

# Optional. Which model answers. Defaults to claude-opus-5.
# Set claude-sonnet-5 or claude-haiku-4-5 to trade some quality for lower cost.
# COACH_MODEL=claude-opus-5
