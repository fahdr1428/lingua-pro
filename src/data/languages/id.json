  "frameworks": [
    {
      "id": "no-conjugation",
      "title": "Verbs never conjugate",
      "body": "Indonesian verbs stay the same regardless of who's doing the action. 'Saya makan' / 'Dia makan' — same verb."
    },
    {
      "id": "no-tense",
      "title": "No verb tenses",
      "body": "There are no past, present, or future verb forms. Time is shown with words like 'kemarin' (yesterday) or 'besok' (tomorrow)."
    },
    {
      "id": "no-gender",
      "title": "No grammatical gender",
      "body": "'Dia' covers both 'he' and 'she'. No masculine/feminine forms to learn."
    },
    {
      "id": "latin-script",
      "title": "Familiar alphabet",
      "body": "Indonesian uses the Latin alphabet and is pronounced almost exactly as written — one of the most learner-friendly languages."
    }
  ],
