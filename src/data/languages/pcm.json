 "frameworks": [
  {
   "id": "dey-verb",
   "title": "'Dey' is the all-purpose 'is/are/am'",
   "body": "'Dey' covers 'is/are/am' AND ongoing action. 'I dey fine' = I'm fine. 'I dey go' = I'm going. One word, huge use."
  },
  {
   "id": "no-conjugation",
   "title": "Verbs barely change",
   "body": "Most Pidgin verbs stay the same regardless of who's doing the action. 'I go', 'You go', 'Dem go' — same 'go'."
  },
  {
   "id": "english-base",
   "title": "English-based but its own language",
   "body": "Nigerian Pidgin (Naijá) is an English-based creole — not 'broken English'. It has its own grammar, words, and is spoken by 100+ million people."
  },
  {
   "id": "o-emphasis",
   "title": "'O' at the end adds feeling",
   "body": "Adding 'o' at the end of a phrase intensifies it. 'Thank you o!' = a warm, emphatic thanks."
  }
 ],
