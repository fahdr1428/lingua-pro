 "alphabet": [
  {
   "char": "C c",
   "name": "Ce",
   "sound": "j as in 'jam' — Turkish 'cami' sounds like 'jah-mee'"
  },
  {
   "char": "Ç ç",
   "name": "Çe",
   "sound": "ch as in 'chair'"
  },
  {
   "char": "Ğ ğ",
   "name": "Yumuşak ge",
   "sound": "soft g — silent, it just lengthens the vowel before it"
  },
  {
   "char": "I ı",
   "name": "I (undotted)",
   "sound": "uh — a relaxed 'schwa' sound, like the a in 'about'"
  },
  {
   "char": "İ i",
   "name": "İ (dotted)",
   "sound": "ee as in 'see'"
  },
  {
   "char": "Ö ö",
   "name": "Ö",
   "sound": "like the 'u' in 'fur' with rounded lips"
  },
  {
   "char": "Ş ş",
   "name": "Şe",
   "sound": "sh as in 'shoe'"
  },
  {
   "char": "Ü ü",
   "name": "Ü",
   "sound": "say 'ee' with tightly rounded lips"
  }
 ],
 "frameworks": [
  {
   "id": "sov",
   "title": "The verb always comes last",
   "body": "Turkish is Subject–Object–Verb: 'Ben kitap okuyorum' is literally 'I book am-reading'. Push the verb to the end of the sentence and you instantly sound Turkish."
  },
  {
   "id": "vowel-harmony",
   "title": "Vowels harmonise",
   "body": "Suffixes change their vowel to match the word: ev → evler (houses), but kitap → kitaplar (books). Back vowels (a, ı, o, u) attract 'a' suffixes; front vowels (e, i, ö, ü) attract 'e' suffixes. It's one rule, applied everywhere."
  },
  {
   "id": "suffixes",
   "title": "Suffixes instead of little words",
   "body": "Where English uses 'at', 'in', 'to', Turkish glues a suffix on: okul (school) → okulda (at school), ev → evde (at home). One word can carry a whole English phrase."
  }
 ],
