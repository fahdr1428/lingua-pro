    {
      "id": "so_0002",
      "unit": "u1",
      "category": "Greetings",
      "lemma": "Iska warran",
      "translation": "how are you? (to a man)",
      "difficulty": 1,
      "note": "Somali greetings change with who you're addressing: 'iska warran' to a man, 'iska warran' shortened to 'warran'; to a woman you say 'is ka warran' or 'nabad miyaa'. Greetings often run several exchanges long before anyone gets to the point.",
      "examples": [
        {
          "native": "Iska warran, saaxiib?",
          "translation": "How are you, friend?"
        }
      ],
      "frequencyRank": 2
    },
    {
      "id": "so_0003",
      "unit": "u1",
      "category": "Greetings",
      "lemma": "Nabad",
      "translation": "peace; fine",
      "difficulty": 1,
      "note": "Somali answers 'how are you' with peace rather than with a state of mind. Nabad runs through the whole greeting sequence.",
      "examples": [
        {
          "native": "Nabad baan ahay",
          "translation": "I am well (I am at peace)"
        }
      ],
      "frequencyRank": 3
    },
